{
  "agentPushNotifEnabled": true,
  "autoCompactEnabled": false,
  "editorMode": "vim",
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "greptile@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "telegram@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "jq -c 'if ((.tool_input.command // \"\") | test(\"skills/subagent-driven-development/scripts/(review-package|task-brief|sdd-workspace)\")) then {hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"allow\",permissionDecisionReason:\"superpowers sdd script\"}} else {} end'",
            "statusMessage": "Проверка разрешений SDD-скриптов",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "language": "russian",
  "model": "claude-fable-5[1m]",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git check-ignore *)",
      "Bash(git branch --show-current *)",
      "Bash(git branch -a *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(jq *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(pwd *)",
      "Bash(whoami *)",
      "Bash(gofmt -l *)",
      "Bash(gofmt -d *)",
      "Bash(go vet *)",
      "Bash(go mod download *)",
      "Bash(go mod tidy *)",
      "Read(**)"
    ],
    "deny": []
  },
  "prefersReducedMotion": true,
  "remoteControlAtStartup": false,
  "spinnerTipsEnabled": true,
  "statusLine": {
    "command": "sh $HOME/.claude/statusline-command.sh",
    "type": "command"
  },
  "teammateMode": "tmux",
  "tui": "fullscreen",
  "verbose": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}